// Registry enumerates only IDs created through the adapter. A reused ID keeps
// its existing registry node; native visibility/validity is checked at export.
int JevObjectiveHead = 0;
void JevObjectiveRegister (int objective) {
    string key = "JevObjectiveRegistry." + IntToString(objective);
    if (DataTableValueExists(true, key)) { return; }
    DataTableSetInt(true, key, JevObjectiveHead);
    JevObjectiveHead = objective;
}

// Presentation adapter used by experimental campaign map copies.
// Mission scripts must use both wrappers together; native terminal objective
// states otherwise end the external API episode before the actual mission ends.
string JevObjectiveStateKey (int objective) {
    return "JevApiCompatibility.ObjectiveState." + IntToString(objective);
}

int JevObjectiveGetState (int objective) {
    string key = JevObjectiveStateKey(objective);
    if (ObjectiveGetState(objective) == c_objectiveStateUnknown) {
        return c_objectiveStateUnknown;
    }
    if (DataTableValueExists(true, key)) {
        return DataTableGetInt(true, key);
    }
    return ObjectiveGetState(objective);
}

void JevObjectiveForget (int objective) {
    string key = JevObjectiveStateKey(objective);
    DataTableValueRemove(true, key);
    DataTableValueRemove(true, key + ".Name");
}

void JevObjectiveSetState (int objective, int state) {
    string key = JevObjectiveStateKey(objective);
    string nameKey = key + ".Name";
    text name;
    if (ObjectiveGetState(objective) == c_objectiveStateUnknown) { return; }
    if (!DataTableValueExists(true, nameKey)) {
        DataTableSetText(true, nameKey, ObjectiveGetName(objective));
    }
    name = DataTableGetText(true, nameKey);
    DataTableSetInt(true, key, state);
    if (state == c_objectiveStateFailed) {
        ObjectiveSetName(objective, StringToText("[Failed] ") + name);
        ObjectiveSetState(objective, c_objectiveStateActive);
    }
    else if (state == c_objectiveStateCompleted) {
        ObjectiveSetName(objective, StringToText("[Completed] ") + name);
        ObjectiveSetState(objective, c_objectiveStateActive);
    }
    else {
        ObjectiveSetName(objective, name);
        ObjectiveSetState(objective, state);
    }
}

int JevObjectiveCreate (text name, text description, int state, bool primary) {
    int objective = ObjectiveCreate(name, description, c_objectiveStateActive, primary);
    JevObjectiveForget(objective);
    JevObjectiveRegister(objective);
    JevObjectiveSetState(objective, state);
    return objective;
}

int JevObjectiveCreateForPlayers (text name, text description, int state, bool primary, playergroup players) {
    int objective = ObjectiveCreateForPlayers(name, description, c_objectiveStateActive, primary, players);
    JevObjectiveForget(objective);
    JevObjectiveRegister(objective);
    JevObjectiveSetState(objective, state);
    return objective;
}

text JevObjectiveGetName (int objective) {
    string key = JevObjectiveStateKey(objective) + ".Name";
    if (ObjectiveGetState(objective) != c_objectiveStateUnknown && DataTableValueExists(true, key)) {
        return DataTableGetText(true, key);
    }
    return ObjectiveGetName(objective);
}

void JevObjectiveSetName (int objective, text name) {
    int state = JevObjectiveGetState(objective);
    if (state == c_objectiveStateUnknown) { return; }
    DataTableSetText(true, JevObjectiveStateKey(objective) + ".Name", name);
    JevObjectiveSetState(objective, state);
}

void JevObjectiveDestroy (int objective) {
    ObjectiveDestroy(objective);
    JevObjectiveForget(objective);
}

// DestroyAll retains its native player-group semantics. GetState/GetName first
// check native validity; a later Create clears cached state before ID reuse.
void JevObjectiveDestroyAll (playergroup players) {
    ObjectiveDestroyAll(players);
}

// Opt-in: caller owns bank freshness and saving. No export occurs implicitly.
void JevVisibleObjectiveExport (bank destination, int player) {
    int oldCount = BankValueGetAsInt(destination, "Objectives", "count");
    int index = 0;
    int objective = JevObjectiveHead;
    string section;
    while (index < oldCount) {
        BankSectionRemove(destination, "Objective" + IntToString(index));
        index += 1;
    }
    index = 0;
    while (objective != 0) {
        if (ObjectiveGetState(objective) != c_objectiveStateUnknown && ObjectiveVisible(objective, player)) {
            section = "Objective" + IntToString(index);
            BankValueSetFromInt(destination, section, "id", objective);
            BankValueSetFromText(destination, section, "name", ObjectiveGetName(objective));
            BankValueSetFromText(destination, section, "description", ObjectiveGetDescription(objective));
            BankValueSetFromInt(destination, section, "state", JevObjectiveGetState(objective));
            BankValueSetFromFlag(destination, section, "primary", ObjectiveGetPrimary(objective));
            index += 1;
        }
        objective = DataTableGetInt(true, "JevObjectiveRegistry." + IntToString(objective));
    }
    BankValueSetFromInt(destination, "Objectives", "count", index);
}
